  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "prestart": "npm run db:prepare && npm run db:deploy && npm run media:sync",
    "start": "next start",
    "typecheck": "next typegen && tsc --noEmit --incremental false",
