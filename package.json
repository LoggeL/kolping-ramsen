    "media:sync": "node scripts/sync-media-assets.mjs",
    "content:audit": "tsx scripts/audit-content.ts",
    "db:prepare": "node scripts/prepare-database.mjs",
    "scrape": "tsx scripts/scrape.ts",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:verify": "node scripts/verify-database.mjs",
    "db:generate": "prisma generate"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
