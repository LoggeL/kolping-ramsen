    "@uiw/react-md-editor": "^4.1.0",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^12.9.0",
    "dotenv": "^17.4.2",
    "isomorphic-dompurify": "^3.21.0",
    "jose": "^6.2.6",
    "marked": "^18.0.7",
    "next": "16.2.12",
    "nodemailer": "^9.0.3",
    "prisma": "^7.9.1",
    "react": "19.2.4",
    "react-dom": "19.2.4",
