# Lokale Datenbank. Das Docker-Image überschreibt den Wert mit file:/data/dev.db.
DATABASE_URL="file:./dev.db"

# Pflichtwert: eigenes Zufallssecret mit mindestens 32 Zeichen eintragen.
SESSION_SECRET=""

# Öffentlicher Origin für Canonicals, Open Graph, Sitemap, Robots und iCalendar.
# Nur http(s), ohne Pfad/Query/Credentials; außerhalb localhost muss es HTTPS sein.
NEXT_PUBLIC_SITE_URL="https://kolping-ramsen.logge.top"

# Im Docker-Image bereits /data/uploads; lokal ohne Wert public/uploads.
MEDIA_UPLOAD_DIR=""

# Aufbewahrung anonymer PageHits in Tagen (1–3650, Standard 180).
ANALYTICS_RETENTION_DAYS="180"

# Nur bei der erstmaligen Anlage eines Admin-Kontos verwenden.
# Es gibt kein Standardpasswort; mindestens 14 eigene Zeichen sind erforderlich.
SEED_ADMIN_EMAIL="admin@kolping-ramsen.de"
SEED_ADMIN_PASSWORD=""

# Kontaktversand arbeitet fail-closed: Ohne SMTP_HOST wird nichts versendet
# oder als Ersatz geloggt. SMTP_USER und SMTP_PASS gemeinsam setzen oder leerlassen.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="kolping-ramsen@gmx.de"
CONTACT_TO="kolping-ramsen@gmx.de"

# Vertrauenswürdige Reverse-Proxies vor Next.js (Dokploy/Traefik direkt: 1).
# Bei direkter Exposition 0 setzen; dann werden Client-IP-Header nicht vertraut.
TRUSTED_PROXY_HOPS="1"

# Begrenzter prozesslokaler Rate-Limit-Speicher (100–100000, Standard 10000).
RATE_LIMIT_MAX_BUCKETS="10000"

# Optionale Quelle für db:prepare; nur als echte Prozessvariable ausgewertet.
# SEED_DATABASE_PATH="./build-dev.db"
