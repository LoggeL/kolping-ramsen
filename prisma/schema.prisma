generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  role         String   @default("redakteur")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  news       News[]
  events     Event[]
  pages      Page[]
}

model Page {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  content     String
  metaTitle   String?
  metaDesc    String?
  parent      String?
  sortOrder   Int      @default(0)
  /// Date used to order chronological archive children independently of manual navigation order.
  archiveDate DateTime?
  published   Boolean  @default(true)
  gallerySlug String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  authorId String?
  author   User?   @relation(fields: [authorId], references: [id])

  @@index([slug])
  @@index([parent])
  @@index([parent, archiveDate])
}

model News {
  id        String   @id @default(cuid())
  slug      String   @unique
  title     String
  date      DateTime
  teaser    String
  content   String
  coverImage String?
  published Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  authorId String?
  author   User?   @relation(fields: [authorId], references: [id])

  @@index([slug])
  @@index([date])
}

model Event {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  /// Civil calendar date. Stored at UTC midnight; never treat it as an instant.
  startDate   DateTime
  endDate     DateTime?
  startTime   String?
  endTime     String?
  allDay      Boolean  @default(true)
  timeZone    String   @default("Europe/Berlin")
  location    String?
  description String
  category    String   @default("alle")
  published   Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  authorId String?
  author   User?   @relation(fields: [authorId], references: [id])

  @@index([slug])
  @@index([startDate])
  @@index([category])
}

model MediaGroup {
  id        String   @id @default(cuid())
  slug      String   @unique
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items MediaGroupItem[]

  @@index([slug])
}

model MediaGroupItem {
  id        String     @id @default(cuid())
  groupId   String
  group     MediaGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  assetId   String
  asset     MediaAsset @relation(fields: [assetId], references: [id], onDelete: Restrict)
  alt       String?
  caption   String?
  sortOrder Int        @default(0)
  createdAt DateTime   @default(now())

  @@index([groupId])
  @@index([assetId])
}

model MediaAsset {
  id           String   @id @default(cuid())
  /// Public URL path without a leading slash. This remains stable after upload.
  path         String   @unique
  originalName String?
  mimeType     String?
  width        Int?
  height       Int?
  sizeBytes    Int?
  sha256       String?
  alt          String   @default("")
  caption      String?
  credit       String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  groupItems MediaGroupItem[]

  @@index([sha256])
}

model PageHit {
  id        String   @id @default(cuid())
  path      String
  referrer  String?
  createdAt DateTime @default(now())

  @@index([path])
  @@index([createdAt])
}

model GuestbookEntry {
  id        String   @id @default(cuid())
  name      String
  message   String
  approved  Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([approved, createdAt])
}

model Redirect {
  id        String   @id @default(cuid())
  fromPath  String   @unique
  toPath    String
  createdAt DateTime @default(now())

  @@index([fromPath])
}

/// Provenance for content created or guardedly cleaned by the legacy migration.
/// The digests make future source/editorial divergence explicit.
model LegacyContentRevision {
  id                   String   @id
  sourceKey            String   @unique
  targetKind           String
  targetKey            String
  sourceDigest         String
  appliedContentDigest String
  snapshotDigest       String
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@index([targetKind, targetKey])
}
